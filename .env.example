# Names only. Copy to .env and fill in; .env is gitignored.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
DATABASE_URL=postgres://sdd:sdd@localhost:5432/sdd

# LLM gateway (see packages/llm/README.md)
# live (default) | mock (no network or keys, serves fixtures) | record (live + save fixtures)
LLM_MODE=
# Model for all calls; leave empty to use the cheap dev default. Set it for real evaluation runs.
LLM_MODEL=

# Where generated CLAUDE.md files and mind maps are written (default: ./output). Never inside the target repo.
CONTEXT_OUTPUT_DIR=

# Repos registered by Git URL are cloned here (default: ./.cache/repos).
CONTEXT_CACHE_DIR=
# Set to false on a shared server: registering a repo by local path makes the server read that folder.
CONTEXT_ALLOW_LOCAL_PATHS=
# Optional comma-separated allow-list of Git hosts, e.g. github.com,gitlab.example.com
CONTEXT_ALLOWED_GIT_HOSTS=
